# Raqib live-mode development credentials.
# OCI Console: Analytics & AI → Generative AI → Projects → create a project
# and a service-specific Generative AI API key. Keep real values in .env only.
OPENAI_API_KEY_CHICAGO=<YOUR_GENAI_API_KEY_HERE>
CHICAGO_PROJECT_OCID=<YOUR_PROJECT_OCID_HERE>

# Guardrails and embeddings use the OCI SDK profile, not the Bearer key above.
OCI_COMPARTMENT_ID=<YOUR_COMPARTMENT_OCID_HERE>

# Runtime and OCI SDK overrides
# RAQIB_REGION=us-chicago-1
# RAQIB_OCI_PROFILE=DEFAULT
# RAQIB_PORT=8117
# RAQIB_DB_PATH=/tmp/raqib-demo.db

# Comma-separated browser origins. Keep this explicit when running the Vite
# development server or exposing the API through another local origin.
# RAQIB_ALLOWED_ORIGINS=http://localhost:8117,http://localhost:5178

# Model overrides — verify every model in the selected region before use.
# RAQIB_ORCHESTRATOR_MODEL=xai.grok-4.20-reasoning
# RAQIB_SAR_MODEL=xai.grok-4.20-multi-agent-0309
# RAQIB_WEB_SEARCH_MODEL=xai.grok-4.20-reasoning
# RAQIB_EMBED_MODEL=cohere.embed-multilingual-v3.0
# RAQIB_VISION_MODEL=xai.grok-4.20-reasoning   # multimodal document extraction

# Managed policy retrieval (Track B). Off by default: search_aml_policy uses
# local OCI-embeddings + cosine search. Set to 1 to serve policy retrieval from
# an OCI Generative AI Vector Store / File Search instead. Requires live mode.
# RAQIB_USE_MANAGED_VECTOR_STORES=0
# Reuse a pre-provisioned store instead of provisioning one on first use:
# RAQIB_VECTOR_STORE_ID=<YOUR_VECTOR_STORE_ID_HERE>
# RAQIB_VECTOR_STORE_NAME=raqib-aml-policy

# Phase 3 investigation upgrades. Each is off by default and, even when enabled,
# only reaches OCI in live mode; without credentials each uses a deterministic
# local fallback so demo mode and tests stay offline.
# RAQIB_EXTRACTION_ENABLED=0        # multimodal document extraction (vision)
# RAQIB_ENRICHMENT_ENABLED=0        # counterparty context enrichment (adverse media)
# RAQIB_RULE_AUTHORING_ENABLED=0    # AI-assisted rule parameter suggestions

# Tests never make live calls unless this separate opt-in is set explicitly.
# RAQIB_RUN_LIVE_TESTS=1
